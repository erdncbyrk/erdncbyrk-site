---
import { steps } from '../data/site';
const dots = [
  'border-silk shadow-[0_0_20px_rgba(241,223,184,0.5)] bg-ink',
  'border-silk-deep shadow-[0_0_20px_rgba(216,183,126,0.45)] bg-ink',
  'border-[#B8B98E] shadow-[0_0_20px_rgba(184,185,142,0.4)] bg-ink',
  'border-mint bg-mint shadow-[0_0_28px_rgba(127,209,168,0.7)]',
];
---
<section id="surec" class="relative mx-auto max-w-[1200px] scroll-mt-28 px-4 pt-32 md:pt-44">
  <h2 class="reveal max-w-[820px] text-[clamp(38px,5vw,64px)] font-medium leading-[1.02] tracking-[-0.035em]">Formu doldurun, <span class="accent">gerisi benden.</span></h2>
  <ol class="relative mt-16 grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-6">
    <span class="absolute bottom-3 left-[11px] top-3 w-0.5 md:bottom-auto md:left-3 md:right-3 md:top-[11px] md:h-0.5 md:w-auto" style="background: linear-gradient(180deg,#F1DFB8,#C9A46A 50%,#7FD1A8)" aria-hidden="true"></span>
    {steps.map((s, i) => (
      <li class="reveal relative flex flex-col gap-4 pl-12 md:pl-0">
        <span class={`absolute left-0 top-0 size-6 rounded-full border-2 md:static ${dots[i]}`} aria-hidden="true"></span>
        <span class={`font-mono text-[13px] ${i === 3 ? 'text-mint' : 'text-[#E6CFA0]'}`}>{s.day}</span>
        <h3 class="text-2xl font-medium">{s.title}</h3>
        <p class="max-w-[250px] text-[15px] leading-relaxed text-muted">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
