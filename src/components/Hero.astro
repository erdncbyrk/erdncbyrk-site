---
import Icon from './Icon.astro';
import { site } from '../data/site';

// Temsili ziyaret verisi (30 gün) -> SVG alan grafiği
const visits = [28, 31, 26, 34, 38, 35, 29, 33, 41, 44, 39, 42, 47, 45, 40, 46, 52, 49, 55, 51, 48, 56, 61, 58, 54, 60, 66, 63, 69, 72];
const W = 560, H = 170, P = 6;
const max = 80;
const pts = visits.map((v, i) => [P + (i * (W - 2 * P)) / (visits.length - 1), H - (v / max) * (H - 10)]);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${(W - P).toFixed(1)} ${H} L${P} ${H} Z`;
const calls = [12, 14, 11, 16, 18, 15, 13, 17, 20, 22, 19, 21, 24, 23, 20, 23, 26, 25, 28, 26, 24, 28, 31, 29, 27, 30, 33, 32, 35, 37];
const line2 = calls.map((v, i) => `${i ? 'L' : 'M'}${(P + (i * (W - 2 * P)) / (calls.length - 1)).toFixed(1)} ${(H - (v / max) * (H - 10)).toFixed(1)}`).join(' ');

const spark = (arr: number[]) => {
  const m = Math.max(...arr), n = Math.min(...arr);
  return arr.map((v, i) => `${i ? 'L' : 'M'}${(i * 72) / (arr.length - 1)} ${22 - ((v - n) / (m - n || 1)) * 18}`).join(' ');
};
const stats = [
  { label: 'Ziyaretçi', value: '1.284', delta: '+18%', s: [4, 6, 5, 7, 8, 7, 9, 11, 10, 12] },
  { label: 'Teklif formu', value: '38', delta: '+9', s: [2, 3, 3, 2, 4, 5, 4, 6, 5, 7] },
  { label: 'Arama butonu', value: '112', delta: '+24%', s: [5, 4, 6, 7, 6, 8, 9, 8, 10, 11] },
  { label: 'WhatsApp', value: '64', delta: '+12', s: [3, 4, 3, 5, 6, 5, 7, 6, 8, 9] },
];
const leads = [
  { name: 'M. Yılmaz', job: 'Mutfak yenileme', area: 'Nilüfer', when: 'Bugün 10:42', status: 'Yeni', tone: 'violet' },
  { name: 'A. Kaya', job: 'Banyo tadilatı', area: 'Osmangazi', when: 'Dün 17:05', status: 'Arandı', tone: 'muted' },
  { name: 'S. Demir', job: 'Anahtar teslim daire', area: 'Mudanya', when: '24 Eyl', status: 'Keşif planlandı', tone: 'lime' },
  { name: 'E. Çelik', job: 'Boya ve alçı', area: 'Yıldırım', when: '23 Eyl', status: 'Teklif gönderildi', tone: 'muted' },
];
const scores = [
  { label: 'Performans', v: 97 },
  { label: 'Erişilebilirlik', v: 100 },
  { label: 'En iyi uyg.', v: 100 },
  { label: 'SEO', v: 100 },
];
---
<section class="relative overflow-hidden px-4 pb-10 pt-36 md:pt-44">
  <!-- light source -->
  <div class="orb left-1/2 top-[-380px] h-[900px] w-[1300px] -translate-x-1/2" style="background: radial-gradient(closest-side, rgba(91,69,240,0.55), rgba(91,69,240,0.12) 55%, transparent)" aria-hidden="true"></div>
  <div class="orb left-1/2 top-[520px] h-[520px] w-[1500px] -translate-x-1/2" style="background: radial-gradient(closest-side, rgba(139,123,255,0.28), transparent)" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[860px] flex-col items-center gap-6 text-center">
    <h1 data-hero-line class="text-[clamp(36px,5.4vw,64px)] leading-[1.08]">
      Yerel işletmeler için<br class="hidden md:block" /> <span class="whitespace-nowrap text-violet">7 günde yayında</span>, sabit fiyatlı web siteleri
    </h1>
    <p data-hero-line class="max-w-[640px] text-base leading-relaxed text-muted md:text-lg">
      Tadilattan kliniğe, müşterisi telefondan arayan işletmeler için hızlı, Google’da bulunan ve güven veren siteler. Toplantı yok, pazarlık yok. Formu doldurursunuz, siteniz gelir.
    </p>
    <div data-hero-line class="flex flex-wrap justify-center gap-3 pt-2">
      <a href={site.orderFormUrl} class="btn-primary">Sipariş ver</a>
      <a href="#surec" class="btn-light">Nasıl çalışır</a>
    </div>
  </div>

  <!-- Product panel -->
  <div data-hero-stage class="relative mx-auto mt-16 max-w-[1180px] md:mt-20" style="perspective: 1800px">
    <div data-hero-panel class="overflow-hidden rounded-2xl border border-white/10 bg-[#0D0A28] text-left shadow-[0_60px_140px_-40px_rgba(91,69,240,0.55)]" role="img" aria-label="Örnek müşteri paneli: ziyaret, teklif talebi ve hız raporları">
      <div class="flex">
        <!-- sidebar -->
        <aside class="hidden w-14 shrink-0 flex-col items-center gap-2 border-r border-white/[0.06] py-4 md:flex">
          <span class="mb-3 flex size-8 items-center justify-center rounded-lg bg-violet-deep text-[11px] font-semibold">UY</span>
          <span class="flex size-9 items-center justify-center rounded-lg text-dim"><Icon name="home" size={18} /></span>
          <span class="flex size-9 items-center justify-center rounded-lg bg-violet/15 text-violet"><Icon name="chart" size={18} /></span>
          <span class="flex size-9 items-center justify-center rounded-lg text-dim"><Icon name="inbox" size={18} /></span>
          <span class="flex size-9 items-center justify-center rounded-lg text-dim"><Icon name="globe" size={18} /></span>
          <span class="mt-auto flex size-9 items-center justify-center rounded-lg text-dim"><Icon name="settings" size={18} /></span>
        </aside>

        <div class="min-w-0 grow">
          <!-- top bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.06] px-4 py-3 md:px-5">
            <div class="flex items-center gap-3">
              <span class="text-sm font-medium">Usta Yapı</span>
              <span class="hidden text-xs text-dim sm:inline">ustayapi.com.tr</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-lime/10 px-2 py-0.5 text-[11px] text-lime"><span class="size-1.5 rounded-full bg-lime"></span>Yayında</span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-muted">
              <span class="rounded-md border border-white/10 px-2 py-1">Son 30 gün</span>
              <span class="hidden rounded-md border border-white/10 px-2 py-1 sm:inline">Rapor indir</span>
            </div>
          </div>

          <div class="grid gap-3 p-3 md:p-4">
            <!-- stats -->
            <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
              {stats.map((s) => (
                <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-3.5">
                  <div class="flex items-center justify-between text-[11px] text-muted"><span>{s.label}</span><span class="text-lime">{s.delta}</span></div>
                  <div class="mt-2 flex items-end justify-between gap-2">
                    <span class="num text-2xl tracking-tight">{s.value}</span>
                    <svg width="72" height="24" viewBox="0 0 72 24" class="hidden sm:block" aria-hidden="true"><path d={spark(s.s)} fill="none" stroke="#8B7BFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </div>
                </div>
              ))}
            </div>

            <div class="grid gap-3 lg:grid-cols-[1fr_300px]">
              <!-- chart -->
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-4">
                <div class="flex items-center justify-between">
                  <span class="text-[13px]">Ziyaretler ve aramalar</span>
                  <span class="flex gap-3 text-[11px] text-muted"><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-violet"></i>Ziyaret</span><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-lime"></i>Arama</span></span>
                </div>
                <svg viewBox={`0 0 ${W} ${H + 18}`} class="mt-3 h-auto w-full" aria-hidden="true">
                  <defs><linearGradient id="va" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8B7BFF" stop-opacity="0.35" /><stop offset="1" stop-color="#8B7BFF" stop-opacity="0" /></linearGradient></defs>
                  {[0.25, 0.5, 0.75, 1].map((f) => <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="rgba(255,255,255,0.06)" />)}
                  <path d={area} fill="url(#va)" />
                  <path data-draw d={line} fill="none" stroke="#8B7BFF" stroke-width="2" stroke-linejoin="round" />
                  <path data-draw d={line2} fill="none" stroke="#DCFF6E" stroke-width="1.6" stroke-linejoin="round" stroke-dasharray="3 3" />
                  {['1 Eyl', '8 Eyl', '15 Eyl', '22 Eyl', '29 Eyl'].map((t, i) => <text x={P + i * ((W - 2 * P) / 4)} y={H + 14} fill="#75719A" font-size="10" text-anchor={i === 0 ? 'start' : i === 4 ? 'end' : 'middle'}>{t}</text>)}
                </svg>
              </div>
              <!-- pagespeed -->
              <div class="rounded-xl border border-white/[0.06] bg-white/[0.025] p-4">
                <div class="flex items-center justify-between"><span class="text-[13px]">PageSpeed · mobil</span><span class="text-[11px] text-dim">Lighthouse</span></div>
                <div class="mt-4 grid grid-cols-2 gap-4">
                  {scores.map((s) => (
                    <div class="flex flex-col items-center gap-2">
                      <span class="relative flex size-16 items-center justify-center">
                        <svg viewBox="0 0 36 36" class="absolute inset-0 -rotate-90" aria-hidden="true"><circle cx="18" cy="18" r="15.5" fill="none" stroke="rgba(220,255,110,0.12)" stroke-width="3" /><circle data-score cx="18" cy="18" r="15.5" fill="none" stroke="#DCFF6E" stroke-width="3" stroke-linecap="round" stroke-dasharray={`${(s.v / 100) * 97.4} 97.4`} /></svg>
                        <span class="num text-[15px] text-lime">{s.v}</span>
                      </span>
                      <span class="text-[11px] text-muted">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="grid gap-3 lg:grid-cols-[1fr_300px]">
              <!-- leads -->
              <div class="overflow-hidden rounded-xl border border-white/[0.06] bg-white/[0.025]">
                <div class="flex items-center justify-between px-4 py-3"><span class="text-[13px]">Son teklif talepleri</span><span class="text-[11px] text-dim">Form · WhatsApp</span></div>
                <table class="w-full text-left text-[12px]">
                  <thead class="text-[11px] text-dim"><tr class="border-t border-white/[0.06]"><th class="px-4 py-2 font-normal">Ad</th><th class="px-2 py-2 font-normal">Hizmet</th><th class="hidden px-2 py-2 font-normal sm:table-cell">Semt</th><th class="hidden px-2 py-2 font-normal md:table-cell">Tarih</th><th class="px-4 py-2 font-normal text-right">Durum</th></tr></thead>
                  <tbody>
                    {leads.map((l) => (
                      <tr class="border-t border-white/[0.06] text-soft">
                        <td class="px-4 py-2.5">{l.name}</td>
                        <td class="px-2 py-2.5">{l.job}</td>
                        <td class="hidden px-2 py-2.5 text-muted sm:table-cell">{l.area}</td>
                        <td class="hidden px-2 py-2.5 text-muted md:table-cell">{l.when}</td>
                        <td class="px-4 py-2.5 text-right"><span class={`inline-block whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] ${l.tone === 'violet' ? 'bg-violet/20 text-[#CFC7FF]' : l.tone === 'lime' ? 'bg-lime/10 text-lime' : 'bg-white/[0.06] text-muted'}`}>{l.status}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <!-- google profile -->
              <div class="hidden rounded-xl border border-white/[0.06] bg-white/[0.025] p-4 lg:block">
                <div class="flex items-center justify-between"><span class="text-[13px]">Google İşletme Profili</span><Icon name="map" size={16} class="text-dim" /></div>
                <div class="mt-3 flex flex-col gap-2.5 text-[12px]">
                  <div class="flex justify-between"><span class="text-muted">Profil görüntüleme</span><span class="num">2.410</span></div>
                  <div class="h-1.5 rounded-full bg-white/[0.06]"><div data-bar class="h-full w-[82%] rounded-full bg-violet"></div></div>
                  <div class="flex justify-between"><span class="text-muted">Yol tarifi</span><span class="num">87</span></div>
                  <div class="h-1.5 rounded-full bg-white/[0.06]"><div data-bar class="h-full w-[38%] rounded-full bg-violet"></div></div>
                  <div class="flex justify-between"><span class="text-muted">Siteye tıklama</span><span class="num">318</span></div>
                  <div class="h-1.5 rounded-full bg-white/[0.06]"><div data-bar class="h-full w-[61%] rounded-full bg-lime"></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-dim">Örnek: Bakım paketinde her ay gönderilen ziyaret ve talep raporu. Veriler temsilidir.</p>
  </div>
</section>
