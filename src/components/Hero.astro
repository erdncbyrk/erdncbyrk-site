---
import { site, facts, sectors } from '../data/site';
const row = [...sectors, ...sectors];
---
<section class="dotgrid relative overflow-hidden px-4 pb-16 pt-28 md:pt-24">
  <!-- wireframe globe -->
  <div class="relative mx-auto flex h-[62vh] min-h-[360px] max-w-[1400px] items-center justify-center md:h-[84vh] md:min-h-[640px]">
    <canvas data-globe class="h-full w-full max-w-[1100px] select-none" aria-hidden="true"></canvas>
    <span data-globe-label class="pointer-events-none absolute left-0 top-0 flex items-center gap-2 whitespace-nowrap rounded-full border border-white/12 bg-coal/80 px-3 py-1.5 text-[10px] uppercase tracking-[0.16em] text-paper/80 opacity-0 backdrop-blur transition-opacity duration-300" aria-hidden="true"><i class="size-1.5 rounded-full bg-pink"></i>online · bursa</span>
  </div>

  <div class="relative mx-auto -mt-[4vh] flex max-w-[1680px] flex-col items-center text-center">
    <h1 class="display text-[clamp(36px,4.9vw,104px)]">
      <span data-hero-line class="inline-block lg:whitespace-nowrap">Esnafın web sitesi<span class="dot">.</span></span>{" "}
      <span data-hero-line class="inline-block">7 günde<span class="dot">.</span></span>
    </h1>
    <p data-hero-line class="mt-7 max-w-[640px] text-sm leading-relaxed text-paper/70 md:text-[15px]">
      Tadilattan kliniğe, müşterisi telefondan arayan işletmeler için hızlı, Google’da bulunan siteler. Sabit fiyat, toplantısız süreç, yazılı teslim tarihi.
    </p>
    <div data-hero-line class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={site.orderFormUrl} class="btn-pink">Sipariş ver <span aria-hidden="true">→</span></a>
      <a href="#yontem" class="btn-line">Nasıl çalışır</a>
    </div>

    <!-- facts bar -->
    <div data-hero-line class="mt-12 flex w-full max-w-[820px] flex-wrap items-stretch justify-center divide-x divide-white/10 rounded-2xl border border-white/10 bg-coal-2/80 backdrop-blur">
      {facts.map((f) => (
        <div class="flex min-w-[45%] grow flex-col items-center gap-1 px-4 py-3 sm:min-w-0">
          <span class="font-display text-lg font-bold">{f.value}</span>
          <span class="text-[10px] uppercase tracking-[0.14em] text-paper/50">{f.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- sectors marquee -->
  <div class="relative mt-14 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]" aria-label="Çalıştığım sektörler">
    <div class="marquee gap-10 text-[13px] uppercase tracking-[0.2em] text-paper/45">
      {row.map((s, i) => <span class="flex items-center gap-10 whitespace-nowrap" aria-hidden={i >= sectors.length ? 'true' : undefined}>{s}<span class="text-pink">/</span></span>)}
    </div>
  </div>
</section>
