---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---
<section id="sss" class="relative mx-auto max-w-[860px] scroll-mt-24 px-4 py-24 md:py-32">
  <div class="flex flex-col items-center gap-5 text-center">
    <span class="chip">Sık sorulanlar</span>
    <h2 data-fade class="text-[clamp(34px,4vw,52px)] leading-[1.08]">Sipariş öncesi merak edilenler</h2>
  </div>
  <div class="mt-12 flex flex-col">
    {faqs.map((f, i) => (
      <details class="faq group border-b border-white/[0.08]" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg text-soft transition-colors hover:text-white group-open:text-white">
          {f.q}
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-white/12 transition-transform duration-300 group-open:rotate-45 group-open:border-violet group-open:text-violet"><Icon name="plus" size={16} /></span>
        </summary>
        <p class="max-w-[640px] pb-6 leading-relaxed text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker { display: none; }
</style>
