---
import { site } from '../data/site';
const quote =
  'Yıllarca insanların teknik sorunlarını çözdüm. Bir esnafın ihtiyacı gösterişli bir ajans değil; hızlı açılan, doğru bilgiyi veren ve telefonu çaldıran bir site. Ben de tam olarak bunu, söz verdiğim tarihte teslim ediyorum.';
const words = quote.split(' ');
---
<section id="hakkimda" class="relative mx-auto max-w-[1180px] scroll-mt-24 px-4 py-24 md:py-40">
  <div class="flex flex-col gap-10 lg:flex-row lg:gap-16">
    <div class="flex shrink-0 flex-col gap-5 lg:w-[260px]">
      <span class="chip self-start">Hakkımda</span>
      <div class="flex items-center gap-4">
        <!-- TODO: gerçek fotoğraf (public/erdinc.jpg) ile değiştir -->
        <span class="flex size-16 items-center justify-center rounded-full border border-dashed border-white/20 bg-white/[0.03] text-[10px] text-dim">Fotoğraf</span>
        <span class="flex flex-col"><span class="text-lg">Erdinç Bayrak</span><span class="text-sm text-muted">Bursa · 2018’den beri teknik işlerde</span></span>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        <a href={site.projectUrl} class="rounded-full border border-white/12 px-4 py-2 text-soft hover:border-violet hover:text-white">Atum Rivals projesi</a>
        <a href={site.cvUrl} class="rounded-full border border-white/12 px-4 py-2 text-soft hover:border-violet hover:text-white">Özgeçmiş</a>
      </div>
    </div>
    <p data-fill class="text-[clamp(26px,3.2vw,44px)] leading-[1.25] tracking-[-0.015em]">
      {words.map((w) => <><span class="fw">{w}</span>{' '}</>)}
    </p>
  </div>
</section>
