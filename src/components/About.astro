---
import { site } from '../data/site';
---
<section id="hakkimda" class="relative scroll-mt-20 px-4 py-28 md:py-40">
  <div class="mx-auto grid max-w-[1180px] gap-12 lg:grid-cols-[300px_1fr] lg:gap-20">
    <div class="flex flex-col gap-6">
      <span class="label">[ Hakkımda ]</span>
      <!-- TODO: gerçek fotoğraf (public/erdinc.jpg) ile değiştir -->
      <div class="flex aspect-[4/5] w-full max-w-[300px] items-center justify-center rounded-2xl border border-dashed border-white/15 bg-coal-2 text-[11px] uppercase tracking-[0.2em] text-paper/35">fotoğraf</div>
      <div class="text-[13px] leading-relaxed text-paper/60">
        <p class="text-paper">Erdinç Bayrak</p>
        <p>Bursa · 2018’den beri teknik işlerde</p>
      </div>
    </div>
    <div class="flex flex-col justify-center">
      <p data-fade class="display text-[clamp(30px,4vw,56px)] !leading-[1.08]">
        Yıllarca insanların teknik sorunlarını çözdüm<span class="dot">.</span> Esnafın ihtiyacı gösterişli bir ajans değil<span class="dot">;</span> telefonu çaldıran bir site<span class="dot">.</span>
      </p>
      <ul data-fade class="mt-10 grid gap-3 text-[13px] text-paper/65 sm:grid-cols-2">
        <li class="flex gap-4"><span class="text-pink">—</span>IT destek uzmanı olarak başladım</li>
        <li class="flex gap-4"><span class="text-pink">—</span>C#, ASP.NET Core ve MSSQL ile web platformu geliştirdim</li>
        <li class="flex gap-4"><span class="text-pink">—</span>Siteleri tek başıma, baştan sona ben yapıyorum</li>
        <li class="flex gap-4"><span class="text-pink">—</span>Tüm hizmetler şahıs şirketim üzerinden faturalı</li>
      </ul>
      <div data-fade class="mt-10 flex flex-wrap gap-3">
        <a href={site.projectUrl} class="btn-line">Atum Rivals projesi</a>
        <a href={site.cvUrl} class="btn-line">Özgeçmiş</a>
      </div>
    </div>
  </div>
</section>
