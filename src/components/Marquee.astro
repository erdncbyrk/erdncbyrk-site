---
import { sectors } from '../data/site';
const row = [...sectors, ...sectors];
---
<section class="mt-16 overflow-hidden border-y border-white/[0.07] py-8 md:mt-24" aria-label="Çalıştığım sektörler">
  <div class="marquee-track gap-14 whitespace-nowrap font-serif text-3xl italic text-faint md:text-[40px]">
    {row.map((s, i) => (
      <span class="flex items-center gap-14" aria-hidden={i >= sectors.length ? 'true' : undefined}>
        {s}<span class="text-gold not-italic text-2xl" aria-hidden="true">✦</span>
      </span>
    ))}
  </div>
</section>
