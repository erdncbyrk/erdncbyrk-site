---
import Arrow from './Arrow.astro';
import { site } from '../data/site';
---
<section id="basla" class="relative mx-4 mt-32 scroll-mt-28 md:mx-auto md:mt-44 md:max-w-[1200px]">
  <div class="reveal relative flex flex-col items-center justify-center gap-7 overflow-hidden rounded-[32px] border border-white/10 bg-panel-2 px-6 py-24 text-center md:py-32">
    <div class="glow left-1/2 top-40 h-[700px] w-[800px] -translate-x-1/2" style="background: radial-gradient(closest-side, rgba(216,183,126,0.35), rgba(46,107,84,0.2) 55%, transparent)"></div>
    <h2 class="relative max-w-[900px] text-[clamp(44px,6.5vw,84px)] font-medium leading-[0.98] tracking-[-0.045em]">Siteniz 7 gün sonra <span class="silk">yayında.</span></h2>
    <p class="relative text-lg text-soft md:text-[19px]">Form 10 dakika sürer. 1 iş günü içinde e-postayla dönüş yapılır.</p>
    <a href={site.orderFormUrl} class="btn-silk relative px-8 py-[18px] text-[17px]">Sipariş formunu doldur <Arrow color="#17130B" /></a>
  </div>
</section>

<footer class="mx-auto mt-24 flex max-w-[1200px] flex-col gap-8 px-4 pb-10">
  <div class="flex flex-col justify-between gap-4 border-t border-white/[0.07] pt-10 text-sm text-muted md:flex-row md:items-center">
    <span>© {new Date().getFullYear()} {site.companyName} · {site.city}</span>
    <span class="font-mono">{site.email}</span>
    <span class="flex gap-5"><a href={site.linkedin} class="hover:text-silk">LinkedIn</a><a href={site.github} class="hover:text-silk">GitHub</a><a href="/kvkk" class="hover:text-silk">KVKK</a></span>
  </div>
  <div class="select-none whitespace-nowrap text-center text-[clamp(56px,15vw,200px)] font-semibold leading-[0.85] tracking-[-0.06em]" style="background: linear-gradient(180deg, rgba(237,234,227,0.14), rgba(237,234,227,0)); -webkit-background-clip: text; background-clip: text; color: transparent;" aria-hidden="true">erdinç bayrak</div>
</footer>
