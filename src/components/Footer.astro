---
import { site } from '../data/site';
import Splash from './Splash.astro';
import InkEdge from './InkEdge.astro';
---
<Splash from="#171717" to="#F6F6F8" />
<section id="basla" class="relative scroll-mt-20 overflow-hidden bg-snow px-4 py-32 text-coal md:py-44">
  <canvas data-particles data-variant="ring" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="relative mx-auto flex max-w-[1000px] flex-col items-center text-center">
    <span class="label">[ Başlayalım ]</span>
    <h2 data-scramble class="display mt-6 text-[clamp(40px,7vw,104px)]">Her esnaf görünür olmayı hak eder<span class="dot">.</span></h2>
    <p data-fade class="mt-7 max-w-[560px] text-sm leading-relaxed text-coal/65 md:text-[15px]">Form yaklaşık 10 dakika sürer. Bilgileriniz ulaştığında 1 iş günü içinde dönüş yapılır, 7. gün siteniz yayındadır.</p>
    <div data-fade class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={site.orderFormUrl} class="btn-pink">Sipariş formunu doldur <span aria-hidden="true">→</span></a>
      <a href={site.whatsappUrl} class="btn-line">WhatsApp’tan yaz</a>
    </div>
  </div>
</section>

<InkEdge from="#F6F6F8" to="#171717" />
<footer class="px-4 py-12 text-[12px] text-paper/55">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-10 md:flex-row md:justify-between">
    <div class="flex flex-col gap-3">
      <span class="font-display text-lg font-extrabold text-paper">bayrak<span class="text-paper/55">dijital</span><span class="dot">.</span></span>
      <span>Küçük işletmeler için sabit fiyatlı web siteleri · {site.city}</span>
      <a href={`mailto:${site.email}`} class="text-paper/80 transition-colors hover:text-paper">{site.email}</a>
    </div>
    <div class="grid grid-cols-2 gap-x-14 gap-y-2.5 uppercase tracking-[0.14em]">
      <a href="#yontem" class="hover:text-paper">Yöntem</a><a href={site.linkedin} class="hover:text-paper">LinkedIn</a>
      <a href="#teshis" class="hover:text-paper">Teşhis</a><a href={site.github} class="hover:text-paper">GitHub</a>
      <a href="#paketler" class="hover:text-paper">Paketler</a><a href="/kvkk" class="hover:text-paper">KVKK</a>
      <a href="#sss" class="hover:text-paper">SSS</a><a href={site.whatsappUrl} class="hover:text-paper">WhatsApp</a>
    </div>
  </div>
  <div class="mx-auto mt-12 flex max-w-[1180px] justify-between border-t border-white/10 pt-6 text-[11px] uppercase tracking-[0.14em] text-paper/35">
    <span>© {new Date().getFullYear()} {site.brand}. Tüm hakları saklıdır.</span><span>faturalı hizmet</span>
  </div>
</footer>
