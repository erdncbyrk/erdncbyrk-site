---
import { site } from '../data/site';
---
<section id="basla" class="relative scroll-mt-24 overflow-hidden px-4 py-28 md:py-40">
  <div class="orb left-1/2 top-1/2 h-[700px] w-[1100px] -translate-x-1/2 -translate-y-1/2" style="background: radial-gradient(closest-side, rgba(91,69,240,0.45), rgba(91,69,240,0.08) 60%, transparent)" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-[760px] flex-col items-center gap-6 text-center">
    <span class="chip">Başlayalım</span>
    <h2 data-fade class="text-[clamp(38px,5vw,64px)] leading-[1.05]">7 gün sonra siteniz yayında olsun</h2>
    <p data-fade class="max-w-[520px] text-lg text-muted">Form yaklaşık 10 dakika sürer. Bilgileriniz ulaştığında 1 iş günü içinde e-postayla dönüş yapılır.</p>
    <div data-fade class="flex flex-wrap justify-center gap-3 pt-2">
      <a href={site.orderFormUrl} class="btn-primary">Sipariş formunu doldur</a>
      <a href="#paketler" class="btn-light">Paketleri incele</a>
    </div>
  </div>
</section>

<footer class="border-t border-white/[0.08] px-4 py-12">
  <div class="mx-auto grid max-w-[1180px] gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="flex flex-col gap-3">
      <span class="flex items-center gap-2.5"><svg width="24" height="24" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="8" fill="#5B45F0" /><path d="M9 8h9M9 14h7M9 20h9M9 8v12" stroke="#fff" stroke-width="2.2" stroke-linecap="round" /></svg><span class="font-medium">Erdinç Bayrak</span></span>
      <p class="max-w-[320px] text-sm leading-relaxed text-muted">Küçük işletmeler için sabit fiyatlı web siteleri. {site.city}.</p>
      <span class="text-sm text-soft">{site.email}</span>
    </div>
    <nav class="flex flex-col gap-2.5 text-sm text-muted" aria-label="Sayfa bağlantıları">
      <span class="mb-1 text-xs text-dim">Sayfa</span>
      <a href="#neden" class="hover:text-white">Neden</a><a href="#surec" class="hover:text-white">Süreç</a><a href="#paketler" class="hover:text-white">Paketler</a><a href="#sss" class="hover:text-white">SSS</a>
    </nav>
    <nav class="flex flex-col gap-2.5 text-sm text-muted" aria-label="Diğer">
      <span class="mb-1 text-xs text-dim">Diğer</span>
      <a href={site.linkedin} class="hover:text-white">LinkedIn</a><a href={site.github} class="hover:text-white">GitHub</a><a href="/kvkk" class="hover:text-white">KVKK aydınlatma metni</a>
    </nav>
  </div>
  <div class="mx-auto mt-12 flex max-w-[1180px] justify-between border-t border-white/[0.06] pt-6 text-xs text-dim">
    <span>© {new Date().getFullYear()} {site.companyName}</span><span>Faturalı hizmet</span>
  </div>
</footer>
