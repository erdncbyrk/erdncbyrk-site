---
import Icon from './Icon.astro';
import { plans, site } from '../data/site';
---
<section id="paketler" class="relative mx-auto max-w-[1180px] scroll-mt-24 px-4 py-24 md:py-32">
  <div class="flex flex-col items-center gap-5 text-center">
    <span class="chip">Paketler</span>
    <h2 data-fade class="text-[clamp(34px,4vw,56px)] leading-[1.08]">Fiyat sayfada yazar, sonradan değişmez</h2>
    <p data-fade class="max-w-[520px] text-muted">Paket dışı istekler (ek sayfa, e-ticaret, özel yazılım) sipariş öncesi yazılı olarak fiyatlandırılır.</p>
  </div>

  <div class="mt-14 grid items-stretch gap-4 lg:grid-cols-3">
    {plans.map((p) => (
      <div data-fade class={`relative flex flex-col gap-7 rounded-2xl p-7 md:p-8 ${p.featured ? 'border border-violet/60 bg-[linear-gradient(180deg,rgba(91,69,240,0.22),rgba(91,69,240,0.04))] shadow-[0_30px_80px_-40px_rgba(91,69,240,0.8)]' : 'panel'}`}>
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between"><h3 class="text-xl">{p.name}</h3>{p.featured && <span class="rounded-full bg-lime px-2.5 py-1 text-xs font-medium text-[#16132B]">Önerilen</span>}</div>
          <p class="text-[15px] leading-normal text-muted">{p.blurb}</p>
        </div>
        <div class="flex items-baseline gap-2"><span class="num text-5xl font-light tracking-[-0.03em]">{p.price}</span><span class="text-sm text-muted">{p.unit}</span></div>
        <ul class="flex flex-col gap-3 border-t border-white/[0.08] pt-6 text-[15px] text-soft">
          {p.features.map((f) => <li class="flex gap-3"><Icon name="check" size={18} class={`mt-0.5 shrink-0 ${p.featured ? 'text-lime' : 'text-violet'}`} />{f}</li>)}
        </ul>
        <a href={site.orderFormUrl} class={`mt-auto ${p.featured ? 'btn-primary' : 'btn-light'}`}>{p.cta}</a>
      </div>
    ))}
  </div>
</section>
