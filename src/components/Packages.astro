---
import { plans, site } from '../data/site';
---
<section id="paketler" class="relative scroll-mt-20 bg-snow px-4 py-28 text-coal md:py-40">
  <div class="mx-auto max-w-[1180px]">
    <div class="flex flex-col items-center text-center">
      <span class="label">[ Paketler ]</span>
      <h2 data-scramble class="display mt-6 text-[clamp(38px,6vw,84px)]">Fiyat yazılı<span class="dot">.</span></h2>
      <p data-fade class="mt-6 max-w-[560px] text-sm leading-relaxed text-coal/65">Paket dışı istekler (ek sayfa, e-ticaret, özel yazılım) sipariş öncesi yazılı olarak fiyatlandırılır.</p>
    </div>

    <div class="mt-16 grid items-stretch gap-4 lg:grid-cols-3">
      {plans.map((p, i) => (
        <div data-fade class={`relative flex flex-col gap-7 rounded-2xl border p-7 md:p-8 ${p.featured ? 'border-coal bg-coal text-paper' : 'border-coal/15 bg-white'}`}>
          <div class="flex items-center justify-between text-[11px] uppercase tracking-[0.2em] opacity-60"><span>0{i + 1}</span>{p.featured && <span class="rounded-full bg-pink px-2.5 py-1 tracking-[0.12em] text-white opacity-100">önerilen</span>}</div>
          <div>
            <h3 class="display text-4xl">{p.name}<span class="dot">.</span></h3>
            <p class={`mt-3 text-[13px] leading-relaxed ${p.featured ? 'text-paper/65' : 'text-coal/60'}`}>{p.blurb}</p>
          </div>
          <div class="flex items-baseline gap-2"><span class="display text-4xl">{p.price}</span><span class="text-[12px] opacity-60">{p.unit}</span></div>
          <ul class={`flex flex-col gap-2.5 border-t pt-6 text-[13px] ${p.featured ? 'border-white/10 text-paper/80' : 'border-coal/10 text-coal/75'}`}>
            {p.features.map((f) => <li class="flex gap-3"><span class={p.featured ? 'text-pink' : 'text-coal/35'}>—</span>{f}</li>)}
          </ul>
          <a href={site.orderFormUrl} class={`mt-auto justify-center ${p.featured ? 'btn-pink' : 'btn-line'}`}>{p.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>
