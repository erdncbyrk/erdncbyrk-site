---
import { numbers, audiences } from '../data/site';
import Icon from './Icon.astro';
---
<section class="relative mx-auto max-w-[1180px] px-4 py-24 md:py-32">
  <div class="flex flex-col items-start gap-5 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col items-start gap-5">
      <span class="chip">Sözleşmeye yazılan sözler</span>
      <h2 data-fade class="max-w-[620px] text-[clamp(34px,4vw,52px)] leading-[1.08]">Ne alacağınızı işe başlamadan bilirsiniz</h2>
    </div>
    <p data-fade class="max-w-[360px] text-muted">Bunlar pazarlama rakamı değil. Her siparişte yazılı olarak verilen teslim koşulları.</p>
  </div>

  <div class="mt-12 grid overflow-hidden rounded-2xl border border-white/[0.08] sm:grid-cols-2 lg:grid-cols-4">
    {numbers.map((n, i) => (
      <div data-fade class={`flex flex-col justify-between gap-10 bg-white/[0.02] p-6 md:p-7 ${i > 0 ? 'border-t border-white/[0.08] sm:border-t-0' : ''} ${i % 2 === 1 ? 'sm:border-l sm:border-white/[0.08]' : ''} ${i >= 2 ? 'sm:border-t sm:border-white/[0.08] lg:border-t-0' : ''} ${i === 2 ? 'lg:border-l lg:border-white/[0.08]' : ''}`}>
        <span class="text-[15px] text-soft">{n.label}</span>
        <div>
          <span class="num block text-[clamp(64px,7vw,96px)] font-light leading-none tracking-[-0.04em]"><span data-count={n.value}>{n.value}</span><span class="text-[0.45em] tracking-normal text-muted">{n.suffix}</span></span>
          <span class="mt-3 block text-sm text-dim">{n.note}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-24 flex flex-col items-center gap-5 text-center md:mt-32">
    <span class="chip">Kimler için</span>
    <h2 data-fade class="max-w-[640px] text-[clamp(30px,3.4vw,44px)] leading-[1.1]">Müşterisi telefondan arayan her işletme</h2>
  </div>
  <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
    {audiences.map((a) => (
      <li data-fade class="panel flex items-center gap-3 px-4 py-4 text-[15px] text-soft">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-violet/15 text-[#CFC7FF]"><Icon name={a.icon} size={17} /></span>
        {a.title}
      </li>
    ))}
  </ul>
</section>
