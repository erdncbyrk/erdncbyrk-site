---
import { site } from '../data/site';
const links = [
  ['#neden', 'Neden'],
  ['#surec', 'Süreç'],
  ['#paketler', 'Paketler'],
  ['#hakkimda', 'Hakkımda'],
  ['#sss', 'SSS'],
];
---
<header data-nav class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="Erdinç Bayrak ana sayfa">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="8" fill="#5B45F0" /><path d="M9 8h9M9 14h7M9 20h9M9 8v12" stroke="#fff" stroke-width="2.2" stroke-linecap="round" /></svg>
      <span class="text-[17px] font-medium tracking-tight">Erdinç Bayrak</span>
    </a>
    <nav class="nav-pill glass hidden items-center gap-1 rounded-full p-1.5 text-sm text-soft lg:flex" aria-label="Ana menü">
      {links.map(([href, label]) => <a href={href} class="rounded-full px-4 py-2 transition-colors hover:bg-white/[0.06] hover:text-white">{label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={site.orderFormUrl} class="btn-primary hidden py-2.5 text-sm sm:inline-flex">Sipariş ver</a>
      <a href="#paketler" class="btn-light py-2.5 text-sm">Fiyatlar</a>
    </div>
  </div>
</header>
