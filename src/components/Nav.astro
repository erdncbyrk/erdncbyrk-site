---
import { site } from '../data/site';
const links = [
  ['#yontem', 'Yöntem'],
  ['#teshis', 'Teşhis'],
  ['#paketler', 'Paketler'],
  ['#hakkimda', 'Hakkımda'],
  ['#sss', 'SSS'],
];
---
<header data-nav class="fixed inset-x-0 top-0 z-50 px-3 pt-3 md:px-4">
  <div class="nav-pill mx-auto grid h-14 max-w-[1040px] grid-cols-[1fr_auto_1fr] items-center rounded-full border border-white/10 bg-[#1c1c1c]/70 pl-5 pr-2 backdrop-blur-md">
    <a href="/" class="flex flex-col justify-self-start leading-none" aria-label="Erdinç Bayrak ana sayfa">
      <span class="font-display text-[15px] font-extrabold tracking-tight">erdncbyrk<span class="dot">.</span></span>
      <span class="mt-1 flex gap-1" aria-hidden="true"><i class="size-1 rounded-full bg-paper"></i><i class="size-1 rounded-full bg-paper"></i><i class="size-1 rounded-full bg-paper"></i><i class="size-1 rounded-full bg-pink"></i></span>
    </a>
    <nav data-menu class="relative hidden items-center rounded-full border border-white/[0.07] bg-white/[0.035] p-1 lg:flex" aria-label="Ana menü">
      <span data-menu-glow aria-hidden="true" class="pointer-events-none absolute left-0 top-1 h-9 rounded-full bg-white/[0.09] opacity-0 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.06)]"></span>
      {links.map(([href, label]) => (
        <a href={href} data-menu-link class="menu-link relative z-[1] inline-flex h-9 items-center gap-2 rounded-full px-4 text-[12px] font-medium uppercase tracking-[0.12em] text-paper/75 transition-colors duration-200 hover:text-paper">
          <i aria-hidden="true" class="menu-dot size-1.5 rounded-full bg-pink"></i>{label}
        </a>
      ))}
    </nav>
    <a href={site.whatsappUrl} data-fill-btn class="relative isolate justify-self-end col-start-3 inline-flex h-9 items-center overflow-hidden rounded-full border border-white/15 px-4 text-[12px] text-paper transition-[color,border-color,transform] duration-[250ms,250ms,140ms] ease-[cubic-bezier(.16,1,.3,1)] hover:scale-[1.02] hover:border-paper/30 hover:text-coal active:scale-[0.98]">
      <span data-fill aria-hidden="true" class="pointer-events-none absolute left-0 top-0 z-0 rounded-full bg-paper will-change-transform" style="transform: scale(0)"></span>
      <span class="relative z-[1] inline-flex items-center gap-2">
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path fill="#25D366" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2s-1 .3-3.3-.7c-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .5l-.3.5-.4.5c-.2.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z" /></svg>
        mesaj at
      </span>
    </a>
  </div>
</header>

<!-- Scroll progress on the right edge -->
<div class="pointer-events-none fixed right-3 top-1/2 z-40 hidden -translate-y-1/2 items-center gap-2 mix-blend-difference md:flex" aria-hidden="true">
  <span class="relative h-24 w-px bg-white/30"><span data-progress-bar class="absolute inset-x-0 top-0 block h-0 bg-white"></span></span>
  <span data-progress class="w-9 text-[10px] tabular-nums text-white/70">0%</span>
</div>
