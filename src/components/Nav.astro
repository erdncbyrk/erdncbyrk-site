---
import { site } from '../data/site';
const links = [
  ['#calismalar', 'Çalışmalar'],
  ['#paketler', 'Paketler'],
  ['#surec', 'Süreç'],
  ['#sss', 'SSS'],
  ['#hakkimda', 'Hakkımda'],
];
---
<header data-nav class="sticky top-4 z-50 flex justify-center px-4 pt-4 md:top-6 md:pt-6">
  <nav class="nav-pill glass flex h-16 w-full max-w-[1120px] items-center justify-between rounded-full pl-5 pr-2" aria-label="Ana menü">
    <a href="/" class="flex items-center gap-2.5">
      <span class="size-[26px] rounded-full" style="background: conic-gradient(from 200deg, #F1DFB8, #C9A46A, #7FB89C, #F1DFB8)"></span>
      <span class="text-[17px] font-semibold tracking-tight">erdinç bayrak</span>
    </a>
    <div class="hidden items-center gap-8 text-sm text-soft lg:flex">
      {links.map(([href, label]) => <a href={href} class="transition-colors hover:text-silk">{label}</a>)}
    </div>
    <div class="flex items-center gap-2">
      <details class="relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/10" aria-label="Menüyü aç">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EDEAE3" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="glass absolute right-0 top-14 flex w-56 flex-col gap-1 rounded-2xl p-2">
          {links.map(([href, label]) => <a href={href} class="rounded-xl px-4 py-3 text-soft hover:bg-white/5 hover:text-silk">{label}</a>)}
        </div>
      </details>
      <a href={site.orderFormUrl} data-magnetic class="rounded-full bg-paper px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-silk">Projeye başla</a>
    </div>
  </nav>
</header>
