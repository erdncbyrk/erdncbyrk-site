---
import { method } from '../data/site';
---
<section id="yontem" class="relative scroll-mt-20 bg-snow text-coal">
  <!-- Intro with particle cloud -->
  <div class="relative flex min-h-[100svh] items-center justify-center overflow-hidden px-4 py-28">
    <canvas data-particles class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <div class="relative mx-auto flex w-full max-w-[900px] flex-col items-center text-center">
      <span class="label">[ Yöntem ]</span>
      <h2 data-scramble class="display mt-6 text-[clamp(44px,7vw,96px)]">7 günlük yöntem<span class="dot">.</span></h2>
      <p data-fade class="mt-7 max-w-[600px] text-sm leading-relaxed text-coal/70 md:text-[15px]">
        Ajanslarda aylar süren iş; toplantı, teklif ve revizyon turları yüzünden uzar. Burada dört adım var, her birinin günü baştan belli.
      </p>
      <p data-fade class="mt-8 text-[12px] uppercase tracking-[0.22em] text-coal/80">
        {method.map((m, i) => <>{i > 0 && <span class="mx-2 text-coal/30">·</span>}<span class={i === method.length - 1 ? 'text-pink' : ''}>{m.name}</span></>)}
      </p>
    </div>
  </div>

  <!-- Desktop: horizontal pinned track -->
  <div data-hscroll class="relative">
    <div data-hscroll-pin class="relative h-screen overflow-hidden">
      <div data-hscroll-track class="flex h-full w-max">
        {method.map((m) => (
          <article class="relative flex h-full w-screen shrink-0 items-center px-[8vw]">
            <span class="display pointer-events-none absolute right-[6vw] top-1/2 -translate-y-1/2 select-none text-[38vw] leading-none text-coal/[0.05]" aria-hidden="true">{m.no}</span>
            <div class="relative max-w-[720px]">
              <h3 class="display text-[clamp(64px,9vw,150px)]">{m.name}<span class="dot">.</span></h3>
              <div class="mt-8 h-px w-40 bg-coal/15"></div>
              <p class="mt-8 text-lg text-coal/85 md:text-xl">{m.lead}</p>
              <ul class="mt-8 flex flex-col gap-3 text-[14px] text-coal/65">
                {m.points.map((pt) => <li class="flex gap-4"><span class="text-coal/30">—</span>{pt}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
      <!-- progress letters -->
      <div class="absolute bottom-10 left-1/2 flex -translate-x-1/2 items-start" aria-hidden="true">
        {method.map((m, i) => (
          <div class="flex items-start">
            <div data-step-dot class={`step-dot flex w-16 flex-col items-center gap-2 ${i === method.length - 1 ? 'text-pink' : ''}`}>
              <span class="font-display text-lg font-extrabold">{m.key}</span>
              <span class="text-[9px] uppercase tracking-[0.18em]">{m.name}</span>
            </div>
            {i < method.length - 1 && <span class="mt-3.5 h-px w-8 bg-coal/25"></span>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile / reduced motion: vertical stack -->
  <div data-vstack class="mx-auto flex max-w-[1100px] flex-col gap-20 px-4 pb-28">
    {method.map((m) => (
      <article data-fade class="relative">
        <span class="display pointer-events-none absolute -top-6 right-0 select-none text-[34vw] leading-none text-coal/[0.05] lg:text-[240px]" aria-hidden="true">{m.no}</span>
        <h3 class="display relative text-[clamp(52px,12vw,110px)]">{m.name}<span class="dot">.</span></h3>
        <p class="relative mt-6 text-lg text-coal/85">{m.lead}</p>
        <ul class="relative mt-6 flex flex-col gap-2.5 text-[14px] text-coal/65">
          {m.points.map((pt) => <li class="flex gap-4"><span class="text-coal/30">—</span>{pt}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
